			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/xml
---
{
	INBOUND_IDOCS_FOR_TID: {
		"import": {
			TID: vars.tid as String
		}
	}
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<sap:synchronous-remote-function-call doc:name="Synchronous Remote Function Call" doc:id="f366f9c7-0a8d-49cd-8994-fdea66754d1e" config-ref="SAP_Config"/>
