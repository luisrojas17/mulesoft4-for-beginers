	</http:request-config>
	<http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config" doc:id="a721807a-5766-4616-95b6-846470cc09c4" >
		<http:listener-connection host="0.0.0.0" port="38024" />
