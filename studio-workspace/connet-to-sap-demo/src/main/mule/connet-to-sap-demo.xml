	<http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config" doc:id="c8778d96-9f25-4ac9-8984-3df4ff3b845f" >
		<http:listener-connection host="0.0.0.0" port="38030" />
	</http:listener-config>
	<sap:sap-config name="SAP_Config" doc:name="SAP Config" doc:id="acad1983-1216-481c-b085-092426a51e73" >
		<sap:simple-connection-provider-connection username="${sap.username}" password="${sap.password}" systemNumber="${sap.system.number}" client="${sap.clientId}" applicationServerHost="${sap.server.host}"/>
	</sap:sap-config>
	<configuration-properties doc:name="Configuration properties" doc:id="2226f014-c7b8-4704-b3a6-5259394a7d11" file="config.properties" />
	<flow name="connet-to-sap-demoFlow" doc:id="c3d44906-e7a3-4f1e-a646-5d4abf6847b9" >
		<http:listener doc:name="/GET TID" doc:id="6afb2638-0851-4deb-b19c-e00f64e53cfd" config-ref="HTTP_Listener_config" path="/getIDocNumberFromTID?tid=0AB022E872FC5F5DD100011C"/>
